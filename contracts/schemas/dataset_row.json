{
  "$defs": {
    "AiVoice": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "source": {
          "enum": [
            "detector",
            "telnyx",
            "timing"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "score",
        "source"
      ],
      "title": "AiVoice",
      "type": "object"
    },
    "Label": {
      "additionalProperties": false,
      "properties": {
        "risk": {
          "enum": [
            "none",
            "watch",
            "alert",
            "urgent"
          ],
