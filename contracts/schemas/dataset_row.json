      "title": "Call Id",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "test_heldout"
      ],
      "title": "Split",
      "type": "string"
    },
    "generator": {
      "title": "Generator",
      "type": "string"
    },
    "profile": {
      "enum": [
        "elder",
        "kid",
        "adult"
      ],
      "title": "Profile",
      "type": "string"
    },
    "rules": {
      "items": {
        "type": "string"
      },
      "title": "Rules",
      "type": "array"
    },
    "rule_flip_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule Flip Of"
    },
    "scam_type": {
      "title": "Scam Type",
      "type": "string"
    },
    "turns": {
