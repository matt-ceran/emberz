      },
      "title": "Turns",
      "type": "array"
    },
    "ask_turn": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ask Turn"
    },
    "benign_twin": {
      "default": false,
      "title": "Benign Twin",
      "type": "boolean"
    },
    "caller_known": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Caller Known"
    },
    "ai_voice": {
      "anyOf": [
        {
          "$ref": "#/$defs/AiVoice"
        },
        {
          "type": "null"
        }
      ],
      "default": null
