        "stage": {
          "enum": [
            "none",
            "hook",
            "trust",
            "pressure",
            "ask"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "risk",
        "category",
        "stage"
      ],
      "title": "Label",
      "type": "object"
    },
    "LabeledTurn": {
      "additionalProperties": false,
      "properties": {
        "turn": {
          "title": "Turn",
          "type": "integer"
        },
        "speaker": {
          "enum": [
            "caller",
            "protected"
          ],
          "title": "Speaker",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        }
      },
      "required": [
        "turn",
        "speaker",
        "text",
        "label"
      ],
      "title": "LabeledTurn",
      "type": "object"
